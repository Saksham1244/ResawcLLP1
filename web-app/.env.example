# ─── Database Configuration ──────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, AWS RDS, or local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/resawc_db?schema=public"

# ─── Security & Authentication ───────────────────────────────────────────────
# Secret key used for signing and verifying JWT tokens (minimum 32 random characters)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_a_secure_random_jwt_secret_at_least_32_characters"

# Secret token used by Desktop Agent to authorize telemetry sync
AGENT_SECRET="replace_with_a_secure_random_agent_secret_token"

# Optional admin secret for administrative operations
ADMIN_RESET_SECRET="replace_with_optional_admin_reset_secret"

# ─── Network & CORS ──────────────────────────────────────────────────────────
# Permitted origins for API requests (optional, defaults to wildcard or domain)
ALLOWED_ORIGIN="https://resawc.com"

# ─── Visual Regression Testing ───────────────────────────────────────────────
# Percy visual diff testing token (optional, for CI)
# PERCY_TOKEN=""
